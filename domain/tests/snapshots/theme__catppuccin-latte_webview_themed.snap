---
source: domain/tests/theme.rs
expression: "theme.webview_css(BodyStyle::Themed)"
---
html,body{height:max-content!important;min-height:0!important;max-height:none!important}
:root{color-scheme:light}
html{background-color:transparent;color:#4c4f69;font:15px/1.55 "Liberation Sans", sans-serif}
body{margin:0;padding:0;overflow-wrap:anywhere}
a{color:#1e66f5}
blockquote{margin:0 0 0 2px;padding-left:12px;border-left:3px solid #dce0e8;color:#85889a}
pre,code,kbd,samp,tt{font-family:"JetBrainsMono Nerd Font", monospace;font-size:13px}
pre{white-space:pre-wrap}
hr{border:0;border-top:1px solid #dce0e8}
img{max-width:100%;height:auto}
table{border-collapse:collapse}
td,th{border-color:#dce0e8}
::selection{background-color:rgba(76, 79, 105, 0.35)}
