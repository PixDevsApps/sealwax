# Typing a password again (ML-048), on a scripted engine: the banner's "Type the password
# again" opens the setup assistant at the password for the account the server refused, with
# its address read only. The password goes to the engine with UpdatePassword; a refusal says
# why and what to do, a password both servers took closes the assistant with a toast. Cancel
# with Escape, the close button, or Back while it checks. Every address, name and host is
# fictional; siri's domain is a preset's only so the assistant knows its app-password page, and
# nothing here reaches the network. Screenshots go to .local/selftest/.
# Run: tools/headless.sh 34 target/debug/sealwax --self-test tests/selftest/status-password.sealwax-test

desktop tiling
resize 1440 900
theme matte-black
corners 0
engine-attach

# Three accounts: Kari signs in with Microsoft (accounts.toml says so), Ola and Siri with
# passwords.
action win.add-account
setup-type setup-address kari@example.test
setup-type setup-name "Kari Nordmann"
setup-type setup-label "Kari Nordmann"
setup-key enter
engine-expect detect
engine-reply detected fjordpost
setup-type setup-password fictional-password-1
setup-key enter
engine-expect verify
engine-reply verified ok
engine-expect add-account
engine-reply added ok
action win.add-account
setup-type setup-address ola@example.test
setup-type setup-name "Ola Hansen"
setup-type setup-label "Ola Hansen"
setup-key enter
engine-expect detect
engine-reply detected fjordpost
setup-type setup-password fictional-password-2
setup-key enter
engine-expect verify
engine-reply verified ok
engine-expect add-account
engine-reply added ok
action win.add-account
setup-type setup-address siri@fastmail.com
setup-type setup-name "Siri Dahl"
setup-type setup-label "Siri Dahl"
setup-key enter
engine-expect detect
engine-reply detected fastmail
setup-type setup-password fictional-password-3
setup-key enter
engine-expect verify
engine-reply verified ok
engine-expect add-account
engine-reply added ok
assert-setup open false
write-file $TMP/config/sealwax/accounts.toml "[[account]]\nkey = \"kari\"\nname = \"Kari Nordmann\"\nlabel = \"Kari Nordmann\"\naddress = \"kari@example.test\"\nauth = \"microsoft\"\n\n[account.imap]\nhost = \"imap.kari.example.test\"\n\n[account.smtp]\nhost = \"smtp.kari.example.test\"\n\n[[account]]\nkey = \"ola\"\nname = \"Ola Hansen\"\nlabel = \"Ola Hansen\"\naddress = \"ola@example.test\"\n\n[account.imap]\nhost = \"imap.ola.example.test\"\n\n[account.smtp]\nhost = \"smtp.ola.example.test\"\nport = 465\n\n[[account]]\nkey = \"siri\"\nname = \"Siri Dahl\"\nlabel = \"Siri Dahl\"\naddress = \"siri@fastmail.com\"\n\n[account.imap]\nhost = \"imap.siri.example.test\"\n\n[account.smtp]\nhost = \"smtp.siri.example.test\"\n"
wait-until assert-label sidebar-summary "3 accounts · all synced"
setup-dismiss-toasts

# The server refused Ola's password: the banner, then the assistant at the password.
engine-reply status ola@example.test needs-sign-in
wait-until assert-label banner-primary "Type the password again"
setup-click banner-primary
assert-setup open true
assert-setup step password-again
assert-label setup-caption "Sign in again"
assert-label setup-title "Ola Hansen"
assert-label setup-subtitle "The server stopped accepting the password Sealwax has. Type it again; nothing syncs until you do."
assert-field setup-address ola@example.test
assert-sensitive setup-address false
assert-shown setup-name false
assert-shown setup-sources false
assert-shown setup-found false
assert-shown setup-manual false
assert-shown setup-back false
assert-shown setup-manual-link false
assert-shown setup-alert false
assert-shown setup-password-field true
assert-label setup-password-label "Password"
assert-shown setup-password-hint false
assert-shown setup-check true
assert-label setup-primary "Sign in"
assert-sensitive setup-primary false
assert-setup focus setup-password
assert-labelled
screenshot $DIR/../../.local/selftest/status-password-again.png
# Enter with nothing typed sends nothing.
setup-key enter
engine-expect none

# A wrong password: refused, with why and what to do; the password field has the focus.
setup-type setup-password fictional-wrong-password
assert-sensitive setup-primary true
setup-key enter
engine-expect update-password key=ola password=fictional-wrong-password
assert-setup step checking
assert-label setup-subtitle "Checking your login with the server…"
assert-shown setup-back true
assert-sensitive setup-password-field false
engine-reply password-updated wrong-password
assert-setup step password-again
assert-shown setup-alert true
assert-label setup-alert-title "Wrong password"
assert-label setup-alert-body "The incoming mail server (IMAP) didn't accept it. Check it and try again; if you changed it at your provider, type the new one."
assert-setup focus setup-password
assert-shown setup-back false
assert-labelled
screenshot $DIR/../../.local/selftest/status-password-refused.png
# SMTP out of reach: the message names its server and port.
setup-type setup-password fictional-password-5
setup-click setup-primary
engine-expect update-password key=ola password=fictional-password-5
engine-reply password-updated smtp unreachable
assert-label setup-alert-title "Couldn't reach the server"
assert-label setup-alert-body "Nothing answers at smtp.ola.example.test on port 465. Check that you're online, then try again."
# The engine couldn't save it: said plainly.
setup-click setup-primary
engine-expect update-password key=ola
engine-reply password-updated other
assert-label setup-alert-title "The password wasn't saved"
# A certificate that doesn't verify.
setup-click setup-primary
engine-expect update-password key=ola
engine-reply password-updated imap certificate
assert-label setup-alert-title "The server's certificate isn't trusted"
assert-text-contains setup-alert-body "imap.ola.example.test showed a certificate"

# Back while it checks: the check is abandoned, and its late answer changes nothing.
setup-click setup-primary
engine-expect update-password key=ola
assert-setup step checking
setup-click setup-back
assert-setup step password-again
engine-reply password-updated ok
assert-setup open true
assert-setup step password-again
engine-reply-stale password-updated ok
assert-setup open true
# Escape closes; the banner stays.
setup-key escape
assert-setup open false
engine-expect none
assert-shown banner true
# So does the close button.
setup-click banner-primary
assert-setup step password-again
assert-shown setup-alert false
setup-click setup-close
assert-setup open false

# Without the engine the assistant says so.
engine-detach
setup-click banner-primary
setup-type setup-password fictional-password-6
setup-key enter
assert-setup step password-again
assert-label setup-alert-title "Not connected to the mail engine"
setup-key escape
engine-attach

# Accepted: the assistant closes with a toast, and the banner goes once the account syncs.
setup-click banner-primary
setup-type setup-password fictional-new-password
setup-key enter
engine-expect update-password key=ola password=fictional-new-password
engine-reply password-updated ok
assert-setup open false
wait-until assert-toast "Password accepted for Ola Hansen"
assert-shown banner true
engine-reply status ola@example.test syncing
wait-until assert-shown banner false
assert-account-status ola@example.test syncing
engine-reply status ola@example.test synced
setup-dismiss-toasts

# A provider that wants an app password: the step says so and links its page.
engine-reply status siri@fastmail.com needs-sign-in
wait-until assert-label banner-title "Siri Dahl needs you to sign in again"
setup-click banner-primary
assert-setup step password-again
assert-label setup-password-label "App password"
assert-shown setup-password-hint true
assert-shown setup-app-password-link true
setup-type setup-password fictional-wrong-password
setup-key enter
engine-expect update-password key=siri
engine-reply password-updated wrong-password
assert-label setup-alert-title "Wrong password"
assert-label setup-alert-body "The incoming mail server (IMAP) didn't accept it. Fastmail needs an app password here, not your account password."
assert-shown setup-alert-link true
screenshot $DIR/../../.local/selftest/status-password-app-password.png
setup-key escape
assert-setup open false

# Kari (Microsoft) comes first in the sidebar, so the banner signs her in; once she syncs,
# Siri's password is next.
engine-reply status kari@example.test needs-sign-in
wait-until assert-label banner-title "Kari Nordmann needs you to sign in again"
assert-label banner-primary "Sign in"
assert-text-contains banner-body " 1 more account needs it too."
assert-setup sign-in-needed kari,siri
engine-reply status kari@example.test synced
wait-until assert-label banner-primary "Type the password again"
# The banner's button while the assistant adds another account: that one closes, and the
# password step opens for Siri.
action win.add-account
setup-type setup-address per@example.test
setup-key enter
engine-expect detect address=per@example.test
setup-click banner-primary
assert-setup step password-again
assert-label setup-title "Siri Dahl"
# The same button again shows the one already open.
setup-click banner-primary
assert-setup step password-again
assert-label setup-title "Siri Dahl"
setup-key escape
assert-setup open false
engine-expect none
