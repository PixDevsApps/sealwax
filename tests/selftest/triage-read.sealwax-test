# Marking a message read when the reader shows it (a proposal behind MARK_READ_ON_OPEN, on in
# this build): without a toast, and without taking the last action's Undo; in the Unread view
# once the selection leaves it, so the view doesn't take the message away while it is read; in
# one pane at a time only once the reader is on screen; Mark as Unread on the open message keeps
# it unread. Every message is fictional.
# Run: tools/headless.sh 23 target/debug/sealwax --self-test tests/selftest/triage-read.sealwax-test

desktop tiling
resize 1440 900
triage-mark-read-on-open true
mail-account Personal
mail-add Personal:inbox 10m "Hyttetur i oktober" "from=Ingrid Solberg"
mail-add Personal:inbox 20m "Styremøte torsdag" "from=Marius Dahl"
mail-add Personal:inbox 30m "Kvittering for bestilling" "from=Leah Kim"
mail-add Personal:inbox 40m "Nyhetsbrev uke 41" "from=Marius Dahl"
mail-add Personal:inbox 50m "Lunsj fredag" "from=Leah Kim"
mail-add Personal:inbox 60m "Budsjett 2027" "from=Marius Dahl"
folder inbox Personal
assert-sidebar-count Personal:inbox 6
focus list

# Shown: read, without a toast.
list-select 0
wait-until assert-list-row 0 unread false
assert-toasts 0
assert-undoable false
assert-sidebar-count Personal:inbox 5

# Archive: the next message is shown and read, and the archive stays the one to undo.
key e
assert-toast "Archived 1 message"
wait-until assert-list-row 0 unread false
assert-toast "Archived 1 message"
assert-undoable true
assert-sidebar-count Personal:inbox 4

# Mark as Unread on the open message keeps it unread.
key <Shift>u
assert-list-row 0 unread true
assert-sidebar-count Personal:inbox 5

# The Unread view: the message shown stays in the view until the selection leaves it.
chip unread
assert-list-count 5
focus list
list-select 1
wait-until assert-reader-page message
sleep 300
assert-list-count 5
assert-list-row 1 unread true
key j
assert-list-count 4
assert-list-selection 1
assert-list-row 1 unread true
sleep 300
assert-list-count 4
chip all

# One pane at a time: a message selected in the list is read once the reader is on screen.
resize 800 900
assert-layout narrow
assert-pane list
focus list
list-select 4
sleep 300
assert-list-row 4 unread true
key Return
assert-pane reader
wait-until assert-list-row 4 unread false

# Off: nothing is marked.
action nav.pane::list
resize 1440 900
triage-mark-read-on-open false
mail-add Personal:inbox now "Ny melding" "from=Leah Kim"
focus list
list-select 0
wait-until assert-reader-page message
sleep 300
assert-list-row 0 unread true
