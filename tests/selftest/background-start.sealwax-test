# Background mode in Sealwaxes of their own (M7, ML-084). Each runs with its own id and XDG
# folders under $TMP, its log in a file of its own; the ones started through the private test bus
# (whose only service is Sealwax's own `--gapplication-service`) log to $TMP/testbus/daemon.err.
# Every name and address is fictional; the account's servers are a closed port on 127.0.0.1.
# Run: tools/headless.sh 58 target/debug/sealwax --self-test tests/selftest/background-start.sealwax-test

desktop tiling

# The one-time notice, across a restart with the same state folder: a Sealwax that closes its
# window 300 ms after its first frame sends it; started again on the same folders, it doesn't.
background-spawn once
wait-until assert-file-contains $TMP/once.err "the last window closed; running in the background"
wait-until assert-file-contains $TMP/once.err "background notice sent"
assert-file-contains $TMP/once/state/sealwax/background-notice-shown "Delete this file"
assert-running once true
signal once TERM
wait-process once 0
background-spawn once
wait-until assert-file-contains $TMP/once.err "the last window closed; running in the background"
sleep 500
assert-file-lacks $TMP/once.err "background notice sent"
assert-running once true
signal once TERM
wait-process once 0
assert-file-contains $TMP/once.err "SIGTERM: quitting"

# `[background] enabled = false`: closing the window quits, with no notice.
write-file $TMP/off/config/sealwax/config.toml "[background]\nenabled = false\n"
background-spawn off
wait-process off 0
assert-file-contains $TMP/off.err "background mode on=false"
assert-file-lacks $TMP/off.err "running in the background"
assert-file-lacks $TMP/off.err "background notice sent"

# `--background` with no Sealwax running: the bus starts the service, which shows no window and
# starts its engine once the store and the settings are ready, with the watch on resume and the
# network; the command line exits.
write-file $TMP/activated/config/sealwax/accounts.toml "[[account]]\nkey = \"kari\"\nname = \"Kari Nordmann\"\naddress = \"kari@example.test\"\n\n[account.imap]\nhost = \"127.0.0.1\"\nport = 1\n\n[account.smtp]\nhost = \"127.0.0.1\"\nport = 1\n"
test-bus-start
test-bus-spawn first --background
wait-process first 0
assert-bus-owner true
wait-until assert-file-contains $TMP/testbus/daemon.err "engine started without a window"
assert-file-count $TMP/testbus/daemon.err "engine started without a window" 1
assert-file-contains $TMP/testbus/daemon.err "accounts=1 accounts_sent=true"
assert-file-contains $TMP/testbus/daemon.err "started without a window"
wait-until assert-file-contains $TMP/testbus/daemon.err "watching the network"
wait-until assert-file-contains $TMP/testbus/daemon.err "watching logind's resume signal"
sleep 500
assert-bus-owner true
assert-file-lacks $TMP/testbus/daemon.err first-frame

# Given to the running Sealwax: `--background` shows nothing; `--compose` opens a composer alone.
test-bus-spawn second --background
wait-process second 0
test-bus-spawn third --compose
wait-process third 0
wait-until assert-file-contains $TMP/testbus/daemon.err "compose requested kind=New(None)"
sleep 500
assert-file-lacks $TMP/testbus/daemon.err first-frame

# An activation shows the main window on the running engine: no second engine.
test-bus-activate
wait-until assert-file-contains $TMP/testbus/daemon.err first-frame
assert-file-count $TMP/testbus/daemon.err "engine started" 2
assert-file-count $TMP/testbus/daemon.err "engine started without a window" 1
assert-file-lacks $TMP/testbus/daemon.err kari@example.test
test-bus-signal TERM
wait-until assert-bus-owner false
assert-file-contains $TMP/testbus/daemon.err "SIGTERM: quitting"
assert-file-contains $TMP/testbus/daemon.err "engine stopped"
test-bus-stop

# `--compose` with no Sealwax running: a composer window alone, and the engine without a window.
test-bus-start
test-bus-spawn first --compose
wait-process first 0
wait-until assert-file-contains $TMP/testbus/daemon.err "compose requested kind=New(None)"
wait-until assert-file-contains $TMP/testbus/daemon.err "engine started without a window"
sleep 500
assert-file-lacks $TMP/testbus/daemon.err first-frame
test-bus-signal TERM
wait-until assert-bus-owner false
test-bus-stop
