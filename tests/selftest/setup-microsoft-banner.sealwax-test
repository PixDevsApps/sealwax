# The window's banner for an account that must sign in again (ML-032; DESIGN.md "Feedback"),
# on a scripted engine. It appears when the engine reports that an account accounts.toml signs
# in with Microsoft needs a sign-in, names the first such account and counts the others, and
# its Sign in opens the assistant straight at Microsoft sign-in for that account. The banner
# goes once the account syncs. A password account that needs a sign-in gets the same banner
# with "Type the password again" (ML-048; status-password.sealwax-test covers that flow). Every
# address, name and link is fictional. Screenshots go to .local/selftest/.
# Run: tools/headless.sh 61 target/debug/sealwax --self-test tests/selftest/setup-microsoft-banner.sealwax-test

desktop tiling
resize 1440 900
theme matte-black
corners 0
engine-attach
write-file $TMP/config/sealwax/config.toml "[oauth.microsoft]\nclient_id = \"fictional-client-id\"\n"
wait-until assert-setup client-id set
assert-shown banner false

# Three accounts, as the assistant adds them: Kari and Anne sign in with Microsoft, Ola with a
# password. The scripted engine keys them by the address's local part.
action win.add-account
setup-type setup-address kari@example.test
setup-type setup-name "Kari Nordmann"
setup-key enter
engine-expect detect
engine-reply detected microsoft
setup-click setup-microsoft-button
engine-expect sign-in address=kari@example.test account=none
engine-reply signed-in ok kari@example.test
engine-expect add-account auth=microsoft sign-in=last
engine-reply added ok
assert-setup open false
action win.add-account
setup-type setup-address ola@example.test
setup-type setup-name "Ola Hansen"
setup-key enter
engine-expect detect
engine-reply detected fjordpost
setup-type setup-password fictional-password-2
setup-key enter
engine-expect verify
engine-reply verified ok
engine-expect add-account auth=password sign-in=none
engine-reply added ok
action win.add-account
setup-type setup-address anne@example.test
setup-type setup-name "Anne Berg"
setup-key enter
engine-expect detect
engine-reply detected microsoft
setup-click setup-microsoft-button
engine-expect sign-in address=anne@example.test
engine-reply signed-in ok anne@example.test
engine-expect add-account auth=microsoft sign-in=last
engine-reply added ok
assert-setup open false
wait-until assert-label sidebar-summary "3 accounts · all synced"
# accounts.toml, as the engine wrote it.
write-file $TMP/config/sealwax/accounts.toml "[[account]]\nkey = \"kari\"\nname = \"Kari Nordmann\"\naddress = \"kari@example.test\"\nauth = \"microsoft\"\n\n[account.imap]\nhost = \"imap.example.test\"\n\n[account.smtp]\nhost = \"smtp.example.test\"\n\n[[account]]\nkey = \"ola\"\nname = \"Ola Hansen\"\naddress = \"ola@example.test\"\n\n[account.imap]\nhost = \"mail.example.test\"\n\n[account.smtp]\nhost = \"mail.example.test\"\n\n[[account]]\nkey = \"anne\"\nname = \"Anne Berg\"\naddress = \"anne@example.test\"\nauth = \"microsoft\"\n\n[account.imap]\nhost = \"imap.example.test\"\n\n[account.smtp]\nhost = \"smtp.example.test\"\n"
assert-shown banner false

# A password account that needs its sign-in gets the banner, with its password (ML-048).
engine-reply sync-failed ola@example.test wrong-password
assert-account-status ola@example.test needs-sign-in
wait-until assert-label sidebar-summary "3 accounts · sign-in needed"
wait-until assert-setup sign-in-needed ola
wait-until assert-shown banner true
assert-label banner-title "ola@example.test needs you to sign in again"
assert-label banner-primary "Type the password again"
engine-reply sync-finished ola@example.test
wait-until assert-shown banner false
assert-setup sign-in-needed none

# Kari's sign-in ended: the banner names her, with Sign in.
engine-reply sync-failed kari@example.test wrong-password
wait-until assert-shown banner true
assert-setup sign-in-needed kari
assert-label banner-title "kari@example.test needs you to sign in again"
assert-label banner-body "Microsoft ended the session. Sealwax keeps your mail; nothing syncs until you sign in."
assert-label banner-primary "Sign in"
assert-sensitive banner-primary true
# Anne's too: still one banner, naming the first and counting the other.
engine-reply sync-failed anne@example.test sign-in-declined
assert-setup sign-in-needed kari,anne
assert-label banner-title "kari@example.test needs you to sign in again"
assert-label banner-body "Microsoft ended the session. Sealwax keeps your mail; nothing syncs until you sign in. 1 more account needs it too."
# The look: across the window's top, the error tint with the text colour, the theme's fonts.
assert-color banner-strip background error-soft
assert-color banner-title text foreground
assert-color banner-body text foreground
assert-contrast banner-strip 4.5
assert-font banner-title chrome
assert-width banner 1440
assert-labelled
screenshot $DIR/../../.local/selftest/setup-banner.png
theme catppuccin-latte
corners 8
assert-color banner-strip background error-soft
assert-contrast banner-strip 4.5
assert-radius banner-strip 0
screenshot $DIR/../../.local/selftest/setup-banner-latte.png
theme matte-black
corners 0
# In every layout.
resize 1100 900
assert-shown banner true
resize 800 900
assert-shown banner true
resize 1440 900

# Sign in: the assistant opens at Microsoft sign-in for Kari and starts it at once.
setup-click banner-primary
assert-setup open true
engine-expect sign-in address=kari@example.test provider=microsoft account=kari
assert-setup step signing-in
assert-label setup-caption "Sign in again"
assert-label setup-title kari@example.test
assert-label setup-subtitle "Sealwax keeps your mail; nothing syncs until you sign in."
assert-field setup-address kari@example.test
assert-sensitive setup-address false
assert-shown setup-name false
assert-shown setup-sources false
assert-shown setup-back false
assert-shown setup-manual-link false
assert-setup focus setup-cancel
engine-reply sign-in-open https://login.example.test/authorize?client_id=fictional&state=again
assert-opened last https://login.example.test/authorize?client_id=fictional&state=again
assert-labelled
screenshot $DIR/../../.local/selftest/setup-again.png
# Signing in again waits as adding an account does: after a minute without an answer (here
# 300 ms from now on), the note on admin approval.
assert-shown setup-still-waiting false
setup-still-waiting-after 300
setup-click setup-cancel
engine-expect cancel-sign-in sign-in=last
setup-click setup-microsoft-button
engine-expect sign-in address=kari@example.test account=kari
wait-until assert-shown setup-still-waiting true
assert-text-contains setup-still-waiting "your organization must approve Sealwax first"
assert-setup focus setup-cancel
setup-still-waiting-after 60000
# Its Sign in again shows the open assistant.
setup-click banner-primary
engine-expect none
assert-setup step signing-in
# Cancel: back to the button, which signs in again; a failure says why.
setup-click setup-cancel
engine-expect cancel-sign-in sign-in=last
assert-setup step microsoft
assert-shown setup-back false
assert-setup focus setup-microsoft-button
setup-click setup-microsoft-button
engine-expect sign-in address=kari@example.test account=kari
engine-reply signed-in timeout
assert-setup step microsoft
assert-label setup-alert-title "The sign-in didn't finish in time"
# Signed in: the assistant closes, nothing is added, and the banner waits for the sync.
setup-click setup-microsoft-button
engine-expect sign-in address=kari@example.test account=kari
engine-reply signed-in ok kari@example.test
assert-setup open false
engine-expect none
assert-shown banner true
assert-label banner-title "kari@example.test needs you to sign in again"
# Kari syncs: the banner moves on to Anne.
engine-reply sync-finished kari@example.test
assert-account-status kari@example.test synced
wait-until assert-label banner-title "anne@example.test needs you to sign in again"
assert-label banner-body "Microsoft ended the session. Sealwax keeps your mail; nothing syncs until you sign in."
assert-setup sign-in-needed anne

# Escape cancels Anne's sign-in, then closes the assistant: her banner stays.
setup-click banner-primary
engine-expect sign-in address=anne@example.test account=anne
setup-key escape
engine-expect cancel-sign-in sign-in=last
assert-setup step microsoft
setup-key escape
assert-setup open false
engine-expect none
assert-shown banner true
# The banner's Sign in while the assistant adds another account: that one closes, and the
# sign-in starts.
action win.add-account
setup-type setup-address per@example.test
setup-key enter
engine-expect detect address=per@example.test
setup-click banner-primary
engine-expect sign-in address=anne@example.test account=anne
assert-label setup-caption "Sign in again"
setup-click setup-close
engine-expect cancel-sign-in sign-in=last
assert-setup open false

# Without a client ID the assistant says how to set one and sends nothing.
write-file $TMP/config/sealwax/config.toml ""
wait-until assert-setup client-id none
setup-click banner-primary
assert-setup step microsoft
assert-shown setup-microsoft-unavailable true
assert-sensitive setup-microsoft-button false
assert-setup focus setup-close
engine-expect none
setup-key escape
assert-setup open false

# Anne syncs: the banner goes.
engine-reply sync-finished anne@example.test
wait-until assert-shown banner false
assert-setup sign-in-needed none
assert-label sidebar-summary "3 accounts · all synced"
# An account accounts.toml signs in with a password is asked for its password, whatever failed.
engine-reply sync-failed ola@example.test sign-in-declined
wait-until assert-shown banner true
assert-label banner-primary "Type the password again"
engine-expect none
