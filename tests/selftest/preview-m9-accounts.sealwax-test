# Preview screenshots of the UI tweaks of 2026-10-08: the setup assistant's first step with
# "Account name" and "Colour", the password step whose list scrolls with its scrollbar beside
# the fields, and two accounts in the sidebar told apart by name and colour, in matte-black
# (dark, square corners as on stock Omarchy) and catppuccin-latte (light, corners rounded 8 as
# on this desktop). A scripted engine answers; every name, address and server is fictional.
# Not part of tools/ci.sh; it writes into tools/progress/public/. Run from the repository root:
#   tools/headless.sh 19 target/debug/sealwax --self-test tests/selftest/preview-m9-accounts.sealwax-test

desktop tiling
resize 1440 900
theme matte-black
corners 0
engine-attach

# The first step: the address, the sender name, the account's name and its colour.
action win.add-account
setup-type setup-address kari@example.test
setup-type setup-name "Kari Nordmann"
setup-type setup-label Work
setup-click setup-color-teal
screenshot $DIR/../../tools/progress/public/m9-accounts-address-matte-black-square-2026-10-08.png
theme catppuccin-latte
corners 8
screenshot $DIR/../../tools/progress/public/m9-accounts-address-catppuccin-latte-rounded-2026-10-08.png
theme matte-black
corners 0

# Every source listed and settings to confirm: the column scrolls, its scrollbar beside the
# fields.
setup-key enter
engine-expect detect
engine-reply progress preset
engine-reply progress autoconfig
engine-reply progress ispdb
engine-reply progress mx
engine-reply progress srv
engine-reply progress probe
engine-reply detected confirm
setup-type setup-password fictional-password
assert-setup step password
assert-right-of setup-scrollbar setup-password
assert-right-of setup-scrollbar setup-username
hover setup-scrollbar
screenshot $DIR/../../tools/progress/public/m9-accounts-scroll-matte-black-square-2026-10-08.png

# Saved with its name and colour, then a second account with neither typed: the address names
# it, and it takes the first colour no account has.
setup-key enter
engine-expect verify label=Work color=teal
engine-reply verified ok
engine-expect add-account "name=Kari Nordmann" label=Work color=teal
engine-reply added ok file
assert-setup open false
action win.add-account
setup-type setup-address nordmann@example.test
setup-type setup-name "Kari Nordmann"
setup-key enter
engine-expect detect
engine-reply detected fjordpost
setup-type setup-password fictional-password
setup-key enter
engine-expect verify label=none color=rose
engine-reply verified ok
engine-expect add-account label=none color=rose
engine-reply added ok file
assert-setup open false
setup-dismiss-toasts
assert-label account-name:account-1 Work
assert-label account-name:account-2 nordmann@example.test
assert-color account-name:account-1 text account-teal
assert-color account-name:account-2 text account-rose
assert-color status:account-1 background account-teal
screenshot $DIR/../../tools/progress/public/m9-accounts-sidebar-matte-black-square-2026-10-08.png
theme catppuccin-latte
corners 8
assert-color account-name:account-1 text account-teal
screenshot $DIR/../../tools/progress/public/m9-accounts-sidebar-catppuccin-latte-rounded-2026-10-08.png

# The rail (900–1279 px): the other account's initial in its colour.
theme matte-black
corners 0
resize 1100 900
screenshot $DIR/../../tools/progress/public/m9-accounts-rail-matte-black-square-2026-10-08.png

# Edit Account from the second account's heading: its menu, then the dialog with both accounts.
resize 1440 900
account-menu account-2
screenshot $DIR/../../tools/progress/public/m9-accounts-heading-menu-matte-black-square-2026-10-08.png
sidebar-menu-click
wait-until assert-dialog "Edit an account"
assert-field edit-account-choice nordmann@example.test
setup-type edit-account-label Home
setup-click edit-account-color-sage
screenshot $DIR/../../tools/progress/public/m9-accounts-edit-matte-black-square-2026-10-08.png
theme catppuccin-latte
corners 8
screenshot $DIR/../../tools/progress/public/m9-accounts-edit-catppuccin-latte-rounded-2026-10-08.png
setup-respond edit-account save
engine-expect edit-account label=Home color=sage
engine-reply edited ok file
wait-until assert-label account-name:account-2 Home
assert-color account-name:account-2 text account-sage
setup-dismiss-toasts
screenshot $DIR/../../tools/progress/public/m9-accounts-edited-catppuccin-latte-rounded-2026-10-08.png
theme matte-black
corners 0
screenshot $DIR/../../tools/progress/public/m9-accounts-edited-matte-black-square-2026-10-08.png

# The layout tweaks: Home folded under its heading (its unread counted there), the borders
# dragged, and the reader's column filling a wide pane, at 1920 px.
mail-add Work:inbox 10m "Melding fra Nordnet Kundeservice" html "from=Nordnet" "text=Hei, du har fått en melding fra oss. Du kan lese meldingen ved å logge inn. Hilsen, Nordnet."
mail-add Home:inbox 20m "Dugnad lørdag" "from=Leah Kim"
resize 1920 1000
click heading:account-2
drag sidebar-handle 30
drag list-handle 40
folder inbox Work
focus list
list-select 0
wait-until assert-reader-page message
hover list-title
sleep 1500
setup-dismiss-toasts
screenshot $DIR/../../tools/progress/public/m9-layout-matte-black-square-2026-10-08.png
theme catppuccin-latte
corners 8
screenshot $DIR/../../tools/progress/public/m9-layout-catppuccin-latte-rounded-2026-10-08.png
