# The accessibility pass (M9, ML-092) on the setup assistant, its failures, Microsoft sign-in and
# Remove Account, on a scripted engine: every control on screen has an accessible name, a role
# that says what it is and the states its role needs (assert-accessible), Tab and Shift+Tab
# (real key presses) go round each step's fields and buttons and stay in the dialog, and Escape
# goes back a step and closes on the first. Every address, name and server is fictional.
# Run: tools/headless.sh 71 target/debug/sealwax --self-test tests/selftest/a11y-setup.sealwax-test

desktop tiling
resize 1440 900
engine-attach

# The welcome page, then the address step, opened from the keyboard.
assert-accessible window
focus add-account
key Return
assert-setup step address
assert-dialog "Add an account"
assert-accessible dialog
assert-accessible-name setup-address "Email address"
assert-accessible-name setup-name "Your name"
assert-accessible-name setup-label "Account name"
tab-chain window forward 20
assert-tab-chain setup-address,setup-name,setup-label,setup-color-rose,setup-manual-link,setup-close,setup-address
tab-chain window backward 20
assert-tab-chain setup-address,setup-close,setup-manual-link,setup-color-rose,setup-label,setup-name,setup-address

# The colours (the UI tweak of 2026-10-08): a radio group with one Tab stop, the first colour no
# account has chosen; the arrows move the choice and the focus, round the row.
assert-accessible-role setup-color radio-group
assert-accessible-name setup-color "Colour"
assert-accessible-role setup-color-rose radio
assert-accessible-name setup-color-rose "Rose"
assert-accessible-state setup-color-rose checked true
assert-accessible-state setup-color-teal checked false
assert-accessible-name setup-color-none "No colour"
focus setup-color-rose
key Right
assert-accessible-state setup-color-clay checked true
assert-accessible-state setup-color-rose checked false
assert-focus-stop setup-color-clay
key End
assert-accessible-state setup-color-none checked true
key Right
assert-accessible-state setup-color-rose checked true
key Left
assert-accessible-state setup-color-none checked true
key Home
assert-accessible-state setup-color-rose checked true
assert-focus-stop setup-color-rose
assert-accessible dialog
tab-chain window forward 20
assert-tab-stops 6
focus setup-address

# Looking up the provider, then the password.
setup-type setup-address kari@example.test
setup-key enter
engine-expect detect address=kari@example.test
engine-reply progress preset
engine-reply progress autoconfig
assert-setup step detecting
assert-accessible dialog
engine-reply detected fastmail
assert-setup step password
assert-accessible dialog
assert-accessible-name setup-password "App password"
assert-setup focus setup-password
tab-chain window forward 20
assert-tab-chain setup-password,setup-app-password-link,setup-manual-link,setup-close,setup-address,setup-password

# A wrong password: the alert, the settings tried, the focus in the password.
setup-type setup-password fictional-password-2
setup-key enter
engine-expect verify username=kari@example.test
assert-setup step checking
assert-accessible dialog
# While it checks, every field waits: Tab and Shift+Tab go between Back and Close (until
# 2026-10-08 the form's scroller took the press and kept the focus on Close).
tab-chain window forward 20
assert-tab-chain setup-back,setup-close,setup-back
tab-chain window backward 20
assert-tab-chain setup-back,setup-close,setup-back
engine-reply verified imap wrong-password
assert-setup step failed
assert-accessible dialog
assert-accessible-role setup-alert alert
assert-accessible-name setup-imap-host "IMAP server"
assert-accessible-name setup-imap-port "IMAP port"
assert-accessible-name setup-imap-security "IMAP security"
assert-accessible-name setup-smtp-host "SMTP server"
assert-accessible-name setup-smtp-port "SMTP port"
assert-accessible-name setup-smtp-security "SMTP security"
assert-setup focus setup-password
tab-chain window forward 40
assert-tab-chain setup-password,setup-back,setup-primary,setup-close,setup-alert-link,setup-incoming,setup-imap-host,setup-imap-port,setup-imap-security,setup-smtp-host,setup-smtp-port,setup-smtp-security,setup-manual-username,setup-password

# POP3 in the manual settings: the protocol choice and its note.
setup-choose setup-incoming POP3
assert-accessible dialog
assert-accessible-name setup-imap-host "POP3 server"
assert-accessible-name setup-imap-port "POP3 port"
assert-accessible-name setup-imap-security "POP3 security"

# Escape goes back a step at a time; on the first step it closes, and the focus returns to the
# window's Add an account.
setup-key escape
assert-setup step password
setup-key escape
assert-setup step address
setup-key escape
assert-setup open false
assert-dialog none
assert-focus add-account

# Microsoft sign-in, without and with a client ID.
setup-click add-account
setup-type setup-address kari@outlook.example.test
setup-key enter
engine-expect detect address=kari@outlook.example.test
engine-reply detected microsoft
assert-setup step microsoft
assert-accessible dialog
assert-accessible-state setup-microsoft-button disabled true
write-file $TMP/config/sealwax/config.toml "[oauth.microsoft]\nclient_id = \"fictional-client-id\"\n"
wait-until assert-sensitive setup-microsoft-button true
assert-accessible dialog
setup-click setup-microsoft-button
engine-expect sign-in address=kari@outlook.example.test
assert-shown setup-waiting true
assert-accessible dialog
setup-key escape
engine-expect cancel-sign-in
assert-setup step microsoft
# The note on admin approval after a minute without an answer (here 300 ms) is spoken, and
# every control stays named with it.
setup-still-waiting-after 300
assert-announced none
setup-click setup-microsoft-button
engine-expect sign-in address=kari@outlook.example.test
wait-until assert-shown setup-still-waiting true
assert-announced "Still waiting for Microsoft. If the browser shows “Need admin approval”, your organization must approve Sealwax first: see the user guide."
assert-accessible dialog
assert-accessible-name setup-cancel Cancel
setup-key escape
engine-expect cancel-sign-in
assert-setup step microsoft
setup-still-waiting-after 60000
setup-key escape
assert-setup step address
setup-key escape
assert-setup open false

# Remove Account: one account through the manual settings, then the confirmation.
setup-click add-account
setup-type setup-address kari@example.test
setup-type setup-name "Kari Nordmann"
setup-click setup-manual-link
setup-type setup-imap-host imap.example.test
setup-type setup-smtp-host smtp.example.test
setup-type setup-password fictional-password-9
setup-key enter
engine-expect verify address=kari@example.test
engine-reply verified ok
engine-expect add-account address=kari@example.test
engine-reply added ok
wait-until assert-setup open false
action win.remove-account
assert-shown remove-account true
assert-accessible dialog
tab-chain window forward 10
key Escape
assert-dialog none
engine-expect none
