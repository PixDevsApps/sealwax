# Previews for the M7 gate, background mode (ML-084): the main menu with Start Sealwax at Login,
# its question, and the menu with it on, in a dark and a light stock theme (matte-black with
# square corners, catppuccin-latte rounded). The autostart entry goes to a sandboxed home, never
# the user's. The one-time notice is a desktop notification, which the notification server
# draws, so it isn't here. Every name and message is fictional.
# Not run by CI: it writes into tools/progress/public/.
# Run: tools/headless.sh 57 target/debug/sealwax --self-test tests/selftest/preview-m7-background.sealwax-test

desktop tiling
fixtures --count 200 --seed 13 --folders single
reply-sandbox
resize 1440 900
theme matte-black
corners 0
list-wait
wait-until assert-reader-built true
list-select 1
wait-until assert-reader-selected

# The menu: Start Sealwax at Login under the settings, off.
wait-until assert-autostart-toggle false
background-menu
screenshot $DIR/../../tools/progress/public/m7-background-menu-matte-black-square-2026-10-06.png
background-menu close

# Its question.
action app.start-at-login
wait-until assert-shown start-at-login true
screenshot $DIR/../../tools/progress/public/m7-background-question-matte-black-square-2026-10-06.png
setup-respond start-at-login start-at-login
wait-until assert-autostart on

# On: the check mark.
wait-until assert-autostart-toggle true
background-menu
screenshot $DIR/../../tools/progress/public/m7-background-menu-on-matte-black-square-2026-10-06.png
background-menu close
action app.start-at-login
wait-until assert-autostart off
setup-dismiss-toasts

# The same in a light theme with rounded corners.
theme catppuccin-latte
corners 8
wait-until assert-autostart-toggle false
background-menu
screenshot $DIR/../../tools/progress/public/m7-background-menu-catppuccin-latte-rounded-2026-10-06.png
background-menu close
setup-dismiss-toasts
action app.start-at-login
wait-until assert-shown start-at-login true
screenshot $DIR/../../tools/progress/public/m7-background-question-catppuccin-latte-rounded-2026-10-06.png
setup-respond start-at-login start-at-login
wait-until assert-autostart-toggle true
background-menu
screenshot $DIR/../../tools/progress/public/m7-background-menu-on-catppuccin-latte-rounded-2026-10-06.png
background-menu close
action app.start-at-login
wait-until assert-autostart off
