# End to end on the Docker mail testbed (start it with tools/testbed/up.sh and tools/testbed/seed.sh):
# the real engine adds two accounts through the setup assistant's manual settings, lists their
# folders and syncs each INBOX's headers into the list. alice is on Dovecot, with Mailpit for the
# SMTP login check (it accepts any login and nothing is sent); perf is on Stalwart with 10,000
# messages, all older than the first-sync window's 90 days, so its INBOX keeps the newest 200
# (ML-043). Then Remove Account deletes alice. Only the testbed CA is trusted, secrets stay in
# memory, and nothing leaves 127.0.0.1.
# Not in CI: it needs the testbed. Gate previews go to tools/progress/public/.
# Run: tools/headless.sh 33 target/debug/sealwax --self-test tests/selftest/testbed-setup.sealwax-test

desktop tiling
resize 1440 900
theme matte-black
corners 0
engine-start $DIR/../../tools/testbed/certs/ca.pem

# alice on Dovecot, set up by hand: 127.0.0.1 isn't something autodetect looks up.
setup-click add-account
setup-type setup-address alice@example.test
setup-type setup-name Alice
setup-click setup-manual-link
assert-setup step manual
setup-type setup-imap-host 127.0.0.1
setup-type setup-imap-port 14993
setup-type setup-smtp-host 127.0.0.1
setup-choose setup-smtp-security starttls
setup-type setup-smtp-port 17025
setup-type setup-manual-username alice
setup-type setup-password testbed-password
assert-sensitive setup-primary true
setup-key enter
wait-until assert-setup open false
wait-until assert-account-status alice@example.test synced

# Its folders: roles from SPECIAL-USE with Norwegian names, the server's counts for folders not
# synced yet, and INBOX's 30 headers, 10 of them unread.
wait-until assert-sidebar-count Alice:inbox 10
folder inbox Alice
assert-list-count 30
assert-sidebar-count Alice:sent 1
screenshot $DIR/../../tools/progress/public/m2-testbed-alice-inbox-2026-10-05.png

# A wrong password is refused before anything is saved, with the reason.
action win.add-account
setup-type setup-address bob@example.test
setup-click setup-manual-link
setup-type setup-imap-host 127.0.0.1
setup-type setup-imap-port 16993
setup-type setup-smtp-host 127.0.0.1
setup-type setup-smtp-port 16465
setup-type setup-manual-username bob
setup-type setup-password not-the-password
setup-key enter
wait-until assert-label setup-title "Couldn't sign in"
assert-text-contains setup-alert-title "password"
screenshot $DIR/../../tools/progress/public/m2-testbed-wrong-password-2026-10-05.png
setup-key escape
setup-key escape
setup-key escape
wait-until assert-setup open false

# perf on Stalwart: the newest 200 of its 10,000 headers (66 of them unread), the rest older
# mail to load on scroll; then both inboxes together.
action win.add-account
setup-type setup-address perf@example.test
setup-type setup-name Perf
setup-click setup-manual-link
setup-type setup-imap-host 127.0.0.1
setup-type setup-imap-port 16993
setup-type setup-smtp-host 127.0.0.1
setup-type setup-smtp-port 16465
setup-type setup-manual-username perf
setup-type setup-password testbed-password
setup-key enter
wait-until assert-setup open false
wait-until assert-account-status perf@example.test synced
wait-until assert-sidebar-count Perf:inbox 66
folder inbox Perf
assert-list-count 200
folder all-inboxes
assert-list-count 230
# Saving perf hands accounts.toml to the engine again: alice's sync keeps running, and stays
# synced.
wait-until assert-account-status alice@example.test synced
wait-until assert-account-status perf@example.test synced
screenshot $DIR/../../tools/progress/public/m2-testbed-all-inboxes-2026-10-05.png

# Remove Account: the dialog asks which; alice goes with her local mail, perf stays.
action win.remove-account
assert-shown remove-account-choice true
setup-respond remove-account remove
wait-until assert-list-count 200
assert-sidebar-count Perf:inbox 66
assert-action-enabled win.remove-account true
