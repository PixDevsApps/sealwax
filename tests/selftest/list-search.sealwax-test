# Search in the message list (ML-026): the store's full-text search, newest first, the first 50
# results and more as the list's end comes into view; in a folder it searches that folder, from
# All Inboxes every folder; chips filter the results; Escape ends the search and the folder shows
# again. Every message is fictional.
# Run: tools/headless.sh 36 target/debug/sealwax --self-test tests/selftest/list-search.sealwax-test

desktop tiling
fixtures --count 1500 --seed 3 --folders spread
resize 1440 900
list-wait
mail-account Personal
folder inbox Personal
mail-add Personal:inbox 2m "Blåbærsyltetøy til hytta" "text=Husk blåbærsyltetøy og vafler til helga."
mail-add Personal:inbox 3m "Oppskrift" "text=Blåbærsyltetøy med lite sukker." read attachment
mail-add Personal:inbox 4m "Handleliste" "text=Melk, brød og egg."
assert-list-count 3

# A word in one folder: its two messages, newest first; the bar says so.
search blåbærsyltetøy
assert-list-search 2 false
assert-list-row 0 subject "Blåbærsyltetøy til hytta"
assert-list-row 1 subject Oppskrift
assert-label list-title Search
assert-label list-subtitle "2 results"
assert-list-sections "Today:2"
screenshot $DIR/../../.local/selftest/list-search-1440.png

# Chips filter the results.
chip unread
assert-list-search 1 false
assert-list-row 0 subject "Blåbærsyltetøy til hytta"
chip attachments
assert-list-search 1 false
assert-list-row 0 subject Oppskrift
chip starred
assert-list-search 0 false
assert-list-empty "No results"
assert-label list-subtitle "No results"
chip all

# Results follow the store: a new match comes in, a flag change shows.
mail-add Personal:inbox 1m "Mer blåbærsyltetøy" "text=Siste glass."
assert-list-search 3 false
assert-list-row 0 subject "Mer blåbærsyltetøy"
mail-flag 0 +read
assert-list-row 0 unread false

# Escape ends the search: the folder again, with its own title.
search-escape
assert-list-count 4
assert-label list-title Inbox
assert-label list-subtitle "2 unread · Personal"
assert-list-focus list

# From All Inboxes the search covers every folder: a common word gives the first 50 results,
# and 50 more once the list's end comes into view.
folder all-inboxes
search the
assert-list-search 50 true
assert-label list-subtitle "50+ results"
list-scroll-end
assert-list-search 100 true
assert-list-placeholders 0

# Nothing matches.
search zzqxv
assert-list-search 0 false
assert-list-empty "No results"

# The Search command puts the focus in the search field; another folder ends the search.
action win.search
assert-list-focus search
folder inbox Personal
assert-label list-title Inbox
assert-list-count 4
assert-list-empty none
