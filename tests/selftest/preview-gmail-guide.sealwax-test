# Screenshots for docs/GMAIL.md: adding a Gmail account with an app password, as 0.4.0 shows it
# (the servers found through Mozilla's ISPDB, with its "Turn on IMAP" note), in catppuccin with
# corners rounded 8. A scripted engine answers and connects nowhere; the address, the name, the
# password and the mail are fictional. Not part of tools/ci.sh; it writes into .local/guide/
# for review before the pictures are copied to docs/images/gmail/. Run from the repository root:
#   tools/headless.sh 41 target/debug/sealwax --self-test tests/selftest/preview-gmail-guide.sealwax-test

desktop tiling
resize 1440 860
theme catppuccin
corners 8
engine-attach
list-clock 2026-10-11T10:30:00

# No account yet.
screenshot $DIR/../../.local/guide/sealwax/1-no-accounts.png

# The first step, filled in.
action win.add-account
setup-type setup-address your.name@gmail.com
setup-type setup-name "Your Name"
setup-type setup-label Gmail
screenshot $DIR/../../.local/guide/sealwax/2-address.png

# Gmail's servers found, the app password typed, without its spaces, and shown with the eye.
setup-key enter
engine-expect detect address=your.name@gmail.com
engine-reply progress preset
engine-reply progress autoconfig
engine-reply progress ispdb
engine-reply progress mx
engine-reply progress srv
engine-reply progress probe
engine-reply detected gmail
setup-type setup-password abcdefghijklmnop
setup-peek setup-password
assert-setup step password
screenshot $DIR/../../.local/guide/sealwax/3-password.png

# Checking the login, then added.
setup-key enter
engine-expect verify
assert-setup step checking
screenshot $DIR/../../.local/guide/sealwax/4-checking.png
engine-reply verified ok
engine-expect add-account
engine-reply added ok
assert-setup open false
mail-add inbox 2h "Your order has shipped" "from=Nordic Books" "text=Good news: your order is on its way and should arrive on Thursday."
mail-add inbox 40m "Dinner on Friday?" "from=Ingrid Solberg" "text=Are you free on Friday? We were thinking of the new place by the harbour, around seven."
engine-reply sync-finished your.name@gmail.com
screenshot $DIR/../../.local/guide/sealwax/5-added.png

# Add Account in the main menu, for someone who already has an account.
setup-dismiss-toasts
menu-open list-menu
screenshot $DIR/../../.local/guide/sealwax/6-menu.png
