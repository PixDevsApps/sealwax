# A POP3 account end to end on the Docker mail testbed (M8, for phase B): the real engine checks
# a POP3 login from the setup assistant's manual settings (Dovecot's POP3 with implicit TLS on
# 14995, Mailpit for the SMTP login check, which accepts any login and sends nothing), refuses a
# wrong password with POP3's server named, then adds alice by POP3: accounts.toml gets her
# [account.pop3] with the safe policy, and the sidebar her local folders. Only the testbed CA is
# trusted, secrets stay in memory, and nothing leaves 127.0.0.1.
# Not in CI: it needs the testbed and the POP3 client (ML-087) and accounts (ML-088), which
# phase B merges; on the setup branch alone the login check answers that it can't reach the
# server (the contract's client answers NotBuilt).
# Run: tools/headless.sh 65 target/debug/sealwax --self-test tests/selftest/testbed-pop3-setup.sealwax-test

desktop tiling
resize 1440 900
theme matte-black
corners 0
engine-start $DIR/../../tools/testbed/certs/ca.pem

# A wrong password is refused before anything is saved, naming POP3's server.
setup-click add-account
setup-type setup-address alice@example.test
setup-type setup-name Alice
setup-click setup-manual-link
setup-choose setup-incoming pop3
setup-type setup-imap-host 127.0.0.1
setup-type setup-imap-port 14995
setup-type setup-smtp-host 127.0.0.1
setup-choose setup-smtp-security starttls
setup-type setup-smtp-port 17025
setup-type setup-manual-username alice
setup-type setup-password not-the-password
assert-sensitive setup-primary true
setup-key enter
wait-until assert-label setup-title "Couldn't sign in"
assert-label setup-alert-body "The incoming mail server (POP3) didn't accept them. Check both, then try again."
assert-field setup-incoming POP3

# The right password: alice is added by POP3, with the safe policy, and her mail downloads into
# her local folders.
setup-type setup-password testbed-password
setup-key enter
wait-until assert-setup open false
assert-file-contains $TMP/config/sealwax/accounts.toml "\n[account.pop3]\nhost = \"127.0.0.1\"\nport = 14995\nsecurity = \"tls\"\nleave_on_server = true\n"
assert-file-lacks $TMP/config/sealwax/accounts.toml "\n[account.imap]"
assert-file-lacks $TMP/config/sealwax/accounts.toml testbed-password
wait-until assert-account-status alice@example.test synced
assert-account-folders alice@example.test Inbox,Drafts,Sent,Archive,Junk,Trash
folder inbox Alice
wait-until assert-list-count 30
assert-shown list-older false
screenshot $DIR/../../.local/selftest/testbed-pop3-alice-inbox.png
