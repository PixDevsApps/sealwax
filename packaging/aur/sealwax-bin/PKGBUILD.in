# Maintainer: PixDevsApps <https://github.com/PixDevsApps>
# The AUR package sealwax-bin (ADR-021): the prebuilt files of a Sealwax release on GitHub, the
# same files as the package built from source (packaging/PKGBUILD.in, whose depends and
# optdepends this keeps; tools/release.py checks that they match). Generated by
# tools/release.py, which fills in the version and the tarball's checksum.
pkgname=sealwax-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Fast, minimal email client for Omarchy (prebuilt)'
arch=('x86_64')
url='https://github.com/PixDevsApps/sealwax'
license=('MIT')
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0' 'sqlite>=3.43' 'glib2' 'gcc-libs' 'glibc')
optdepends=(
  'gnome-keyring: a Secret Service that keeps passwords and sign-in tokens'
  'hunspell: spell checking in the composer, with a dictionary such as hunspell-en_us'
  'hunspell-en_us: an English dictionary for spell checking (other hunspell dictionaries work too)'
)
provides=("sealwax=$pkgver")
conflicts=('sealwax')
options=('!debug' '!strip')
source=("$url/releases/download/v$pkgver/sealwax-$pkgver-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cp -dr --no-preserve=ownership "$srcdir/usr" "$pkgdir/"
}
